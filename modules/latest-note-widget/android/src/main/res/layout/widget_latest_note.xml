<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_latest_note_background"
    android:orientation="vertical"
    android:paddingHorizontal="18dp">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        >
        <TextView
            android:id="@+id/latest_note_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/latest_note_widget_ink"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textSize="29sp"
            android:layout_marginVertical="10dp"
            />

        <ImageButton
            android:id="@+id/latest_note_add"
            android:layout_width="57dp"
            android:layout_height="57dp"
            android:contentDescription="@string/latest_note_widget_button_desc"
            android:src="@drawable/widget_latest_note_add_button" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.18"
        android:background="@color/latest_note_widget_ink"/>
    <TextView
        android:id="@+id/latest_note_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:fontFamily="serif"
        android:ellipsize="end"
        android:maxLines="6"
        android:textColor="@color/latest_note_widget_ink"
        android:textSize="14sp"
        android:lineHeight="24sp"
        />
    <TextView
        android:id="@+id/latest_note_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:fontFamily="serif"
        android:paddingBottom="30dp"
        android:textColor="@color/latest_note_widget_ink"
        android:textSize="14sp"
        android:alpha="0.5"
        android:textAlignment="center"
        android:lineHeight="24sp"
        android:text="@string/latest_note_widget_placeholder"
        android:gravity="center_vertical"
        android:visibility="gone"
        />
</LinearLayout>
